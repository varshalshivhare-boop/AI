{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantmind.dev/contracts/backtest_job.v1.json",
  "title": "backtest_job.v1",
  "description": "A backtest request created by the API (PC 3) and executed by the quant-engine worker (PC 2). Frozen at v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "job_id", "status", "requested_by", "config",
    "created_at", "provider_ts", "ingest_ts", "data_mode"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "type": "string", "format": "uuid" },
    "status": { "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"] },
    "requested_by": { "type": "string", "minLength": 1, "maxLength": 64 },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy", "symbols", "timeframe", "date_from", "date_to",
        "initial_capital", "risk_per_trade_pct", "fee_schedule_version", "slippage_model"
      ],
      "properties": {
        "strategy": { "type": "string", "pattern": "^[A-Z_]{3,64}$" },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 32 }
        },
        "timeframe": { "enum": ["1m", "5m", "15m", "30m", "1d"] },
        "date_from": { "type": "string", "format": "date" },
        "date_to": { "type": "string", "format": "date" },
        "initial_capital": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]{1,2})?$",
          "description": "INR, decimal string."
        },
        "risk_per_trade_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "fee_schedule_version": {
          "type": "string",
          "description": "Effective-date identifier of the configured fee schedule file."
        },
        "slippage_model": { "type": "string", "minLength": 1, "maxLength": 64 },
        "walk_forward": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["train_sessions", "test_sessions"],
          "properties": {
            "train_sessions": { "type": "integer", "minimum": 1 },
            "test_sessions": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "result_ref": {
      "type": ["string", "null"],
      "description": "Reference to the backtest_runs row. Results are not embedded in this message."
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "maxLength": 64 },
        "message": { "type": "string", "maxLength": 500 }
      }
    },
    "provider_ts": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Timestamp of the latest source market data used by the job, if any."
    },
    "ingest_ts": { "type": "string", "format": "date-time" },
    "data_mode": { "enum": ["LIVE", "REPLAY", "DEMO", "HISTORICAL"] }
  }
}
