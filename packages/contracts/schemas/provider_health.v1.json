{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quantmind.ai/schemas/provider_health.v1.json",
  "title": "ProviderHealthV1",
  "type": "object",
  "required": ["provider", "status", "timestamp", "latency_ms", "data_mode"],
  "properties": {
    "provider": { "type": "string" },
    "status": { "type": "string", "enum": ["HEALTHY", "DEGRADED", "DOWN"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "latency_ms": { "type": "number" },
    "last_tick_age_seconds": { "type": "number" },
    "failed_calculations": { "type": "number" },
    "redis_status": { "type": "string" },
    "db_status": { "type": "string" },
    "data_mode": { "type": "string", "enum": ["LIVE", "REPLAY", "DEMO"] }
  }
}
