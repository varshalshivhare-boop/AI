{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantmind.dev/contracts/candle.open.v1.json",
  "title": "candle.open.v1",
  "description": "An UNFINISHED candle for live views, published to candles.open.<timeframe>. Never persisted to the candles table and never published to candles.closed.*. Proposed in Phase 2 for review; candle.closed.v1 is unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "symbol",
    "exchange",
    "timeframe",
    "session_date",
    "bar_start_ts",
    "bar_end_ts",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "tick_count",
    "is_final",
    "is_missing",
    "provider_ts",
    "ingest_ts",
    "data_mode"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "exchange": {
      "enum": [
        "NSE",
        "BSE"
      ]
    },
    "timeframe": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1d"
      ]
    },
    "session_date": {
      "type": "string",
      "format": "date",
      "description": "IST trading session date this candle belongs to."
    },
    "bar_start_ts": {
      "type": "string",
      "format": "date-time"
    },
    "bar_end_ts": {
      "type": "string",
      "format": "date-time"
    },
    "open": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"
    },
    "high": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"
    },
    "low": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"
    },
    "close": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"
    },
    "volume": {
      "type": "integer",
      "minimum": 0
    },
    "tick_count": {
      "type": "integer",
      "minimum": 0
    },
    "is_final": {
      "const": false,
      "description": "Always false for open candles."
    },
    "is_missing": {
      "type": "boolean",
      "description": "True for a gap bar. Gap bars carry no prices and are never interpolated."
    },
    "provider_ts": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ingest_ts": {
      "type": "string",
      "format": "date-time"
    },
    "data_mode": {
      "enum": [
        "LIVE",
        "REPLAY",
        "DEMO",
        "HISTORICAL"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "is_missing": {
            "const": true
          }
        },
        "required": [
          "is_missing"
        ]
      },
      "then": {
        "properties": {
          "volume": {
            "const": 0
          },
          "tick_count": {
            "const": 0
          }
        }
      }
    }
  ]
}
