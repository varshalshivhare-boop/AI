{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantmind.dev/contracts/signal.generated.v1.json",
  "title": "signal.generated.v1",
  "description": "An explainable BUY, SELL or NO_TRADE decision produced by the quant engine (PC 2). Research and paper-trading output only. Frozen at v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "signal_id", "symbol", "exchange", "action", "price",
    "signal_ts", "expires_at", "strategy", "timeframe", "regime",
    "probability", "calibrated", "volume_confirmation", "order_flow",
    "structure_explanation", "evidence", "invalidation_conditions",
    "entry_zone", "stop_loss", "targets", "risk_reward", "reason_code",
    "provider_ts", "ingest_ts", "data_mode"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "signal_id": { "type": "string", "format": "uuid" },
    "symbol": { "type": "string", "minLength": 1, "maxLength": 32 },
    "exchange": { "enum": ["NSE", "BSE"] },
    "action": { "enum": ["BUY", "SELL", "NO_TRADE"] },
    "price": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,4})?$",
      "description": "Last price at signal_ts."
    },
    "signal_ts": {
      "type": "string",
      "format": "date-time",
      "description": "Close time of the bar that produced the signal. Execution is modelled on the next bar."
    },
    "expires_at": { "type": "string", "format": "date-time" },
    "strategy": { "type": "string", "pattern": "^[A-Z_]{3,64}$" },
    "timeframe": { "enum": ["1m", "5m", "15m", "30m", "1d"] },
    "regime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trend", "volatility", "pressure"],
      "properties": {
        "trend": { "enum": ["TRENDING_UP", "TRENDING_DOWN", "RANGING", "UNCERTAIN"] },
        "volatility": { "enum": ["HIGH", "LOW", "NORMAL", "UNCERTAIN"] },
        "pressure": { "enum": ["BUYING", "SELLING", "NEUTRAL", "UNCERTAIN"] }
      }
    },
    "probability": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Only populated when calibrated is true. Never an uncalibrated model score."
    },
    "calibrated": { "type": "boolean" },
    "volume_confirmation": { "enum": ["CONFIRMED", "NOT_CONFIRMED", "UNAVAILABLE"] },
    "order_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["AVAILABLE", "UNAVAILABLE"] },
        "evidence": { "type": "array", "items": { "type": "string", "maxLength": 300 } }
      }
    },
    "structure_explanation": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "source", "description"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z_]{3,64}$" },
          "source": { "enum": ["PRICE_ACTION", "VOLUME", "ORDER_FLOW", "REGIME", "RISK"] },
          "description": { "type": "string", "maxLength": 300 },
          "value": { "type": ["number", "string", "null"] }
        }
      }
    },
    "invalidation_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "maxLength": 300 }
    },
    "entry_zone": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,4})?$" },
        "high": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,4})?$" }
      }
    },
    "stop_loss": { "type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]{1,4})?$" },
    "targets": {
      "type": ["array", "null"],
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,4})?$" }
    },
    "risk_reward": { "type": ["number", "null"], "minimum": 0 },
    "reason_code": {
      "type": ["string", "null"],
      "enum": [
        "DATA_INSUFFICIENT", "DATA_STALE", "NO_SETUP", "RISK_REJECTED",
        "REGIME_UNCERTAIN", "COST_EXCEEDS_EDGE", "OUTSIDE_SESSION", "STRATEGY_DISABLED", null
      ],
      "description": "Required for NO_TRADE. Null for BUY and SELL."
    },
    "provider_ts": { "type": ["string", "null"], "format": "date-time" },
    "ingest_ts": { "type": "string", "format": "date-time" },
    "data_mode": { "enum": ["LIVE", "REPLAY", "DEMO", "HISTORICAL"] }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "NO_TRADE" } }, "required": ["action"] },
      "then": {
        "required": ["reason_code"],
        "properties": {
          "reason_code": { "type": "string" },
          "entry_zone": { "type": "null" },
          "stop_loss": { "type": "null" },
          "targets": { "type": "null" },
          "risk_reward": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "reason_code": { "type": "null" },
          "entry_zone": { "type": "object" },
          "stop_loss": { "type": "string" },
          "targets": { "type": "array" }
        },
        "required": ["entry_zone", "stop_loss", "targets", "risk_reward"]
      }
    },
    {
      "if": { "properties": { "calibrated": { "const": true } }, "required": ["calibrated"] },
      "then": { "properties": { "probability": { "type": "number" } }, "required": ["probability"] },
      "else": { "properties": { "probability": { "type": "null" } } }
    }
  ]
}
