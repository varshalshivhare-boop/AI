# =============================================================================
# QuantMind AI - environment template
# Copy to .env and fill in. NEVER commit .env. Values shown are placeholders.
# Generate secrets with:  openssl rand -hex 64
# =============================================================================

# -----------------------------------------------------------------------------
# Global
# -----------------------------------------------------------------------------
# development | staging | production
APP_ENV=development
# Timezone for display only. All storage is UTC.
DISPLAY_TIMEZONE=Asia/Kolkata
# Log level for all services: debug | info | warn | error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Infrastructure (used by docker compose and all services)
# -----------------------------------------------------------------------------
POSTGRES_USER=quantmind
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=quantmind
POSTGRES_HOST_PORT=5432
# Connection string used by PC 1, PC 2 and PC 3 when running outside Docker
DATABASE_URL=postgresql://quantmind:CHANGE_ME_postgres_password@localhost:5432/quantmind

REDIS_HOST_PORT=6379
# Used by services running outside Docker
REDIS_URL=redis://localhost:6379/0

PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
# Only used with: docker compose --profile observability up -d
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# -----------------------------------------------------------------------------
# PC 1 - market-data service (services/market-data)
# -----------------------------------------------------------------------------
# Which provider to run: REPLAY (offline, fixtures) | UPSTOX (live, needs credentials)
# REPLAY is the default so the service runs with no broker account.
MARKET_DATA_PROVIDER=REPLAY
# REPLAY only: directory containing SYNTHETIC or labelled historical CSVs
REPLAY_FIXTURE_DIR=./fixtures
# REPLAY only: 1, 10, or 0 for as-fast-as-possible
REPLAY_SPEED=10
# Instruments to subscribe to, comma-separated
MARKET_DATA_WATCHLIST=RELIANCE,HDFCBANK,INFY

# Upstox credentials. Leave empty unless MARKET_DATA_PROVIDER=UPSTOX.
# Where to get them: create an app in the Upstox developer console
# (log in to your Upstox account, open the developer section and create an app).
# Upstox issues the API key and secret for the app. The access token is produced
# by completing Upstox's OAuth login flow for that app. Access tokens expire daily.
# Check the current Upstox documentation for exact steps and any terms that apply.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=

# Feed reconnect and staleness
PROVIDER_RECONNECT_MAX_BACKOFF_SECONDS=60
# During market hours, no tick for this long -> provider state DEGRADED
STALE_DATA_THRESHOLD_SECONDS=15

# Phase 2 service settings (serve command)
MARKET_DATA_HTTP_PORT=8001
# Stop waiting for the flush after this many seconds; exit 1 if it does not finish
SHUTDOWN_TIMEOUT_SECONDS=10
# Only for TEST calendars (calendars/nse_holidays_TEST_ONLY.yaml). Never set in production.
ALLOW_TEST_CALENDAR=false
# Open (unfinished) candles are published at most once per bar per this interval
OPEN_CANDLE_INTERVAL_SECONDS=1.0

# Calendar and persistence
# Versioned holiday file. Update it yearly from the exchange circular.
TRADING_CALENDAR_FILE=./services/market-data/calendars/nse_holidays.yaml
# Raw ticks are NOT stored by default. Read docs/DATA_PROVIDER.md before enabling.
TICK_PERSISTENCE_ENABLED=false
# Must also be true for tick persistence to start. Record who confirmed the licence and when
# in docs/DATA_PROVIDER.md before setting this.
TICK_LICENCE_CONFIRMED=false
TICK_BATCH_SIZE=500
TICK_FLUSH_MS=500
TICK_RETENTION_DAYS=7
# Redis Streams trim length for ticks.normalized (approximate MAXLEN)
TICKS_STREAM_MAXLEN=100000
CANDLES_STREAM_MAXLEN=10000

# -----------------------------------------------------------------------------
# PC 2 - quant engine (services/quant-engine)
# -----------------------------------------------------------------------------
# Versioned fee schedule. Effective-dated. Rates are NOT hardcoded in code.
FEE_SCHEDULE_FILE=./services/quant-engine/config/fees/2026-04-01.yaml
FEE_SCHEDULE_VERSION=2026-04-01
# Slippage model name and default, in basis points per side
SLIPPAGE_MODEL=FIXED_BPS_DEFAULT
SLIPPAGE_BPS=5
# Position sizing
DEFAULT_CAPITAL_INR=500000
MAX_RISK_PER_TRADE_PCT=1.0
# Signals older than this are marked EXPIRED
SIGNAL_TTL_MINUTES=30
# Regime thresholds (defaults, documented in docs/metrics)
REGIME_ADX_TREND_THRESHOLD=25
# Set true only after a calibrated model passes out-of-sample validation
ML_PROBABILITY_ENABLED=false
MODEL_REGISTRY_DIR=./services/quant-engine/models

# -----------------------------------------------------------------------------
# PC 3 - API (apps/api)
# -----------------------------------------------------------------------------
API_PORT=3000
API_CORS_ORIGIN=http://localhost:3002
# Swagger UI at /docs. Ignored when APP_ENV=production.
API_DOCS_ENABLED=true

# JWT. Generate each with: openssl rand -hex 64
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Login rate limiting
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Gateway backpressure
WS_CLIENT_QUEUE_MAX=500
WS_HEARTBEAT_SECONDS=20
# Client receives a stale warning after this many seconds without updates
WS_STALE_WARNING_SECONDS=30

# Redis consumer group for the gateway
GATEWAY_CONSUMER_GROUP=gateway
GATEWAY_CONSUMER_NAME=gateway-1

# -----------------------------------------------------------------------------
# Alerts (apps/api, alert service)
# -----------------------------------------------------------------------------
# Where to get the bot token: open Telegram, start a chat with @BotFather,
# send /newbot and follow the prompts. BotFather returns the token.
TELEGRAM_BOT_TOKEN=
# The chat or channel ID that receives alerts. Obtain it after adding the bot to
# the chat, by reading the chat ID from the Bot API getUpdates response for your bot.
TELEGRAM_CHAT_ID=
# One alert per (symbol, strategy, timeframe, action) within this window
ALERT_DEDUP_WINDOW_SECONDS=900
# Telegram alerts are sent only when this is true AND data_mode is LIVE
TELEGRAM_ALERTS_ENABLED=false

# -----------------------------------------------------------------------------
# Web (apps/web, Next.js). NEXT_PUBLIC_* values are visible to browsers.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
# Set to true to point the UI at the mock server with DEMO banners
NEXT_PUBLIC_USE_MOCK=true
