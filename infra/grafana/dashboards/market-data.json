{
  "uid": "qm-market-data",
  "title": "QuantMind - Market Data (PC 1)",
  "tags": [
    "quantmind",
    "market-data"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ticks received per second",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ticks_received_total[1m]))",
          "legendFormat": "{{tf}}{{reason}}{{stream}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Rejected ticks per second, by reason",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(ticks_rejected_total[5m]))",
          "legendFormat": "{{tf}}{{reason}}{{stream}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Seconds since last accepted tick",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_tick_age_seconds",
          "legendFormat": "{{tf}}{{reason}}{{stream}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Candles emitted per minute, by timeframe",
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 18,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tf) (rate(candles_emitted_total[5m])) * 60",
          "legendFormat": "{{tf}}{{reason}}{{stream}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Provider reconnects (cumulative)",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reconnects_total",
          "legendFormat": "{{tf}}{{reason}}{{stream}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Redis publish errors per second, by stream",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stream) (rate(redis_publish_errors_total[5m]))",
          "legendFormat": "{{tf}}{{reason}}{{stream}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Intraday bars without ticks (gaps)",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tf) (increase(candle_gaps_total[1h]))",
          "legendFormat": "{{tf}}{{reason}}{{stream}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Candle store errors",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(store_errors_total[1h])",
          "legendFormat": "{{tf}}{{reason}}{{stream}}"
        }
      ]
    }
  ]
}
